# Copy to .env and fill in. Never commit .env.
# In CI and on Render, set the same names as GitHub Secrets / Render environment variables.

# Required from the phase that first uses them
DASHBOARD_PASSWORD=            # dashboard login (Phase 1 web core)
SESSION_SECRET=                # random string that signs the login cookie (Phase 1 web core)
SEC_USER_AGENT=                # "Name email@example.com", required by SEC EDGAR fair-access rules (Phase 2)
ANTHROPIC_API_KEY=             # bull / bear / neutral reporters (Phase 4)

# Optional: each one closes a specific data gap
GITHUB_TOKEN=                  # higher GitHub API rate limits locally (CI provides its own)
SERPAPI_KEY=                   # Google Trends fallback when pytrends is rate-limited

# Copy to .env and fill in. Never commit .env. An empty value means off.

# Sign in (required)
DASHBOARD_PASSWORD=
# any long random text, e.g. python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Data shown. Both empty = the committed SQLite file, data/offline/signal-monitor.sqlite (DATA_DB wins over DATA_DIR)
DATA_DB=
# set to "data" to read data/marts instead of the SQLite file
DATA_DIR=

# Collecting data (optional: a source without its key is skipped)
# "Your Name you@example.com", required by SEC EDGAR
SEC_USER_AGENT=
# not needed if you are signed in with `gh auth login`
GITHUB_TOKEN=
# free key from openrouter.ai, turns on the model-benchmark source
OPENROUTER_API_KEY=

# Rarely needed
# 1 only when served over HTTPS (Render sets it)
COOKIE_SECURE=
# built dashboard folder, default frontend/dist
FRONTEND_DIR=

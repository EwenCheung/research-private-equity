{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai_report.schema.json",
  "title": "AI report",
  "description": "Output of one reporter (bull, bear or neutral) for one edition. Bull and bear are case_report; neutral is neutral_report.",
  "oneOf": [{ "$ref": "#/$defs/case_report" }, { "$ref": "#/$defs/neutral_report" }],
  "$defs": {
    "header": {
      "type": "object",
      "required": ["edition", "reporter", "model", "generated_at", "evidence_as_of", "headline"],
      "properties": {
        "edition": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
        "reporter": { "enum": ["bull", "bear", "neutral"] },
        "model": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "evidence_as_of": { "type": "string", "format": "date" },
        "headline": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "description": "A citation. chart_id must exist and value must match the mart (gate checked in code).",
      "type": "object",
      "required": ["chart_id", "metric", "value", "as_of", "source"],
      "additionalProperties": false,
      "properties": {
        "chart_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
        "metric": { "type": "string" },
        "value": { "type": "number" },
        "as_of": { "type": "string", "format": "date" },
        "source": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
      }
    },
    "argument": {
      "type": "object",
      "required": ["claim", "evidence", "strength", "invalidated_by"],
      "additionalProperties": false,
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "strength": { "enum": ["strong", "moderate", "weak"] },
        "invalidated_by": { "description": "What observation would disprove the claim.", "type": "string", "minLength": 1 }
      }
    },
    "case_report": {
      "allOf": [{ "$ref": "#/$defs/header" }],
      "type": "object",
      "required": ["reporter", "arguments", "valuation", "catalysts"],
      "unevaluatedProperties": false,
      "properties": {
        "reporter": { "enum": ["bull", "bear"] },
        "arguments": { "type": "array", "minItems": 4, "maxItems": 8, "items": { "$ref": "#/$defs/argument" } },
        "valuation": { "type": "string", "minLength": 1 },
        "catalysts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "neutral_report": {
      "allOf": [{ "$ref": "#/$defs/header" }],
      "type": "object",
      "required": ["reporter", "debates", "net_read", "confidence", "watch_next", "data_gaps"],
      "unevaluatedProperties": false,
      "properties": {
        "reporter": { "const": "neutral" },
        "debates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["topic", "bull", "bear", "verdict", "evidence_quality", "evidence"],
            "additionalProperties": false,
            "properties": {
              "topic": { "type": "string" },
              "bull": { "type": "string" },
              "bear": { "type": "string" },
              "verdict": { "type": "string" },
              "evidence_quality": { "enum": ["strong", "mixed", "thin"] },
              "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
            }
          }
        },
        "net_read": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["low", "medium", "high"] },
        "watch_next": { "type": "array", "items": { "type": "string" } },
        "data_gaps": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

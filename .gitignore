# local worktrees: .claude/worktrees/ is the standard (the Claude app and `claude --worktree` create them there)
.claude/worktrees/

# secrets
.env

# the offline SQLite file is committed, so a clone has the same data; what a refresh leaves beside it is not
data/offline/*
!data/offline/signal-monitor.sqlite
data/raw/_rejected/


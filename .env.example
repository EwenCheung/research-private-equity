# Copy to .env and fill in what you need. Never commit .env.
# In CI and on Render, set the same names as GitHub Secrets / Render environment variables.
# A line is NAME=value. An empty value leaves that setting off.

# ---- Sign in (required to open the dashboard) ----
# The password you type on the login page.
DASHBOARD_PASSWORD=
# Long random text that signs the login cookie. Make one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# ---- What the dashboard shows ----
# The committed SQLite file: the charts, the registry and the Refresh data button. `python -m pipeline.offline serve` sets this
# itself; it is here for starting the backend with plain uvicorn. The path is from the folder you start the server in (the repo root).
DATA_DB=data/offline/signal-monitor.sqlite
# Only used when DATA_DB is empty: read data/marts and data/registry.json instead (set it to: data). Both empty shows the sample
# charts in tests/fixtures.
DATA_DIR=

# ---- Needed to collect data (Refresh data, `python -m pipeline.offline fetch`) ----
# "Your Name you@example.com". SEC EDGAR requires it; without it the two SEC sources (fund marks, filings naming) are skipped.
SEC_USER_AGENT=
# Optional: higher GitHub rate limits for the two GitHub sources. Not needed if you are signed in with `gh auth login`.
GITHUB_TOKEN=
# Optional: a free key from openrouter.ai that turns on the model-benchmark source. Without it that source is skipped.
OPENROUTER_API_KEY=

# ---- Rarely needed ----
# Set to 1 when the site is served over HTTPS (Render sets it). Leave empty on http://localhost, or the browser drops the login.
COOKIE_SECURE=
# The folder of the built dashboard. Default: frontend/dist. `serve` sets it.
FRONTEND_DIR=

# Not here: API_PORT and WEB_PORT (the dev ports) are read from the shell, not from this file:
#   API_PORT=8002 WEB_PORT=5175 npm --prefix frontend run dev
